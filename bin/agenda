#!/bin/sh
# Today and tomorrow, read from Calendar through EventKit.
# Usage: agenda [--watch]
BIN="$HOME/rex/bin/agenda-events"

show() {
  printf '\033[2J\033[H'
  printf '\033[1m%s\033[0m\n\n' "$(date '+%A %d %B')"
  out=$("$BIN" 2>/dev/null)
  if [ -z "$out" ] || [ "$out" = "DENIED" ]; then
    printf '  \033[2mmacOS has not granted calendar access to Rex Server yet.\033[0m\n'
    printf '  \033[2mSystem Settings -> Privacy & Security -> Calendars -> Rex Server\033[0m\n'
  else
    today=$(printf '%s\n' "$out" | awk -F'\t' '$1<=0 {printf "  %-8s %s\n", $2, $3}')
    tom=$(printf '%s\n' "$out" | awk -F'\t' '$1==1 {printf "  %-8s %s\n", $2, $3}')
    [ -n "$today" ] && printf '%s\n' "$today" || printf '  \033[2mnothing today\033[0m\n'
    printf '\n\033[2m%s\033[0m\n' "$(date -v+1d '+%a %d %b')"
    [ -n "$tom" ] && printf '\033[2m%s\033[0m\n' "$tom" || printf '  \033[2mnothing\033[0m\n'
  fi
  printf '\n\033[2mrefreshed %s\033[0m\n' "$(date '+%H:%M')"
}

if [ "$1" = "--watch" ]; then
  while :; do show; sleep 600; done
else
  show
fi
