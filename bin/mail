#!/Users/ivan/rex/venv/bin/python
"""Mail in a pane, the way a mail app works: folders on the left, messages in the middle,
the message below, and buttons for the things you do with it.

Talks to Gmail over IMAP. The app password lives in Keychain under rex-gmail.
"""
import email
import email.header
import email.utils
import imaplib
import json
import os
import smtplib
import subprocess
import threading
from email.message import EmailMessage

from textual import on, work
from textual.app import App, ComposeResult
from textual.containers import Horizontal, Vertical, VerticalScroll
from textual.screen import ModalScreen
from textual.widgets import (Button, DataTable, Footer, Header, Input, Label, ListItem,
                             ListView, Static, TextArea)

CFG = os.path.expanduser("~/.config/rex-comms/mail.json")
DEFAULT = {"address": "ivan@encore.dev", "imap": "imap.gmail.com", "smtp": "smtp.gmail.com",
           "name": "Ivan"}
FOLDERS = [("Inbox", "INBOX"), ("Starred", "[Gmail]/Starred"), ("Sent", "[Gmail]/Sent Mail"),
           ("All mail", "[Gmail]/All Mail"), ("Trash", "[Gmail]/Trash")]


def config():
    if not os.path.exists(CFG):
        os.makedirs(os.path.dirname(CFG), exist_ok=True)
        with open(CFG, "w") as f:
            json.dump(DEFAULT, f, indent=2)
    with open(CFG) as f:
        return {**DEFAULT, **json.load(f)}


def password():
    try:
        out = subprocess.run(["security", "find-generic-password", "-s", "rex-gmail", "-w"],
                             capture_output=True, text=True, timeout=10)
        return out.stdout.strip() or None
    except Exception:
        return None


def decode(value):
    if not value:
        return ""
    parts = []
    for text, charset in email.header.decode_header(value):
        if isinstance(text, bytes):
            try:
                parts.append(text.decode(charset or "utf-8", "replace"))
            except LookupError:
                parts.append(text.decode("utf-8", "replace"))
        else:
            parts.append(text)
    return " ".join("".join(parts).split())


def sender_name(value):
    name, address = email.utils.parseaddr(decode(value))
    return name or address


class Mailbox:
    """One IMAP connection, used from worker threads behind a lock."""

    def __init__(self, cfg, secret):
        self.cfg = cfg
        self.secret = secret
        self.lock = threading.Lock()
        self.conn = None
        self.folder = None

    def connect(self):
        if self.conn is not None:
            try:
                self.conn.noop()
                return self.conn
            except Exception:
                self.conn = None
                self.folder = None
        conn = imaplib.IMAP4_SSL(self.cfg["imap"], 993)
        conn.login(self.cfg["address"], self.secret)
        self.conn = conn
        return conn

    def select(self, folder, readonly=False):
        conn = self.connect()
        if self.folder != (folder, readonly):
            conn.select(f'"{folder}"', readonly=readonly)
            self.folder = (folder, readonly)
        return conn

    def headers(self, folder, limit=60):
        with self.lock:
            conn = self.select(folder, readonly=False)
            typ, data = conn.uid("search", None, "ALL")
            if typ != "OK":
                return []
            uids = data[0].split()[-limit:]
            if not uids:
                return []
            spec = b",".join(uids)
            typ, raw = conn.uid("fetch", spec,
                                "(FLAGS BODY.PEEK[HEADER.FIELDS (FROM SUBJECT DATE)])")
            if typ != "OK":
                return []
            rows, current = [], {}
            for item in raw:
                if isinstance(item, tuple):
                    meta = item[0].decode("latin-1", "replace")
                    head = email.message_from_bytes(item[1])
                    uid = ""
                    if "UID " in meta:
                        uid = meta.split("UID ", 1)[1].split()[0].strip(")")
                    current = {
                        "uid": uid,
                        "unread": "\\Seen" not in meta,
                        "flagged": "\\Flagged" in meta,
                        "from": sender_name(head.get("From", "")),
                        "subject": decode(head.get("Subject", "")) or "(no subject)",
                        "date": head.get("Date", ""),
                    }
                    rows.append(current)
            rows.reverse()
            return rows

    def body(self, folder, uid):
        with self.lock:
            conn = self.select(folder, readonly=False)
            typ, raw = conn.uid("fetch", uid, "(BODY.PEEK[])")
            if typ != "OK" or not raw or not isinstance(raw[0], tuple):
                return "", {}
            message = email.message_from_bytes(raw[0][1])
            text = ""
            html = ""
            for part in message.walk():
                kind = part.get_content_type()
                if part.get_filename():
                    continue
                if kind == "text/plain" and not text:
                    text = part.get_payload(decode=True).decode(
                        part.get_content_charset() or "utf-8", "replace")
                elif kind == "text/html" and not html:
                    html = part.get_payload(decode=True).decode(
                        part.get_content_charset() or "utf-8", "replace")
            if not text and html:
                text = subprocess.run(["w3m", "-T", "text/html", "-dump", "-cols", "100"],
                                      input=html, capture_output=True, text=True).stdout
            meta = {"from": decode(message.get("From", "")),
                    "to": decode(message.get("To", "")),
                    "subject": decode(message.get("Subject", "")),
                    "date": message.get("Date", ""),
                    "message_id": message.get("Message-ID", "")}
            return text.strip(), meta

    def store(self, folder, uid, flags, plus=True):
        with self.lock:
            conn = self.select(folder)
            conn.uid("store", uid, ("+" if plus else "-") + "FLAGS", flags)

    def move(self, folder, uid, target):
        with self.lock:
            conn = self.select(folder)
            try:
                conn.uid("move", uid, f'"{target}"')
            except Exception:
                conn.uid("copy", uid, f'"{target}"')
                conn.uid("store", uid, "+FLAGS", "\\Deleted")
                conn.expunge()

    def send(self, to, subject, body, reply_to_id=None):
        message = EmailMessage()
        message["From"] = f"{self.cfg['name']} <{self.cfg['address']}>"
        message["To"] = to
        message["Subject"] = subject
        if reply_to_id:
            message["In-Reply-To"] = reply_to_id
            message["References"] = reply_to_id
        message.set_content(body)
        with smtplib.SMTP_SSL(self.cfg["smtp"], 465, timeout=30) as smtp:
            smtp.login(self.cfg["address"], self.secret)
            smtp.send_message(message)


class Compose(ModalScreen[dict]):
    CSS = """
    Compose { align: center middle; }
    #sheet { width: 92; height: 30; padding: 1 2; background: #161b21; border: tall #5ad1c4; }
    #sheet Input { margin-bottom: 1; }
    #sheet TextArea { height: 16; margin-bottom: 1; }
    """

    def __init__(self, to="", subject="", body="", reply_to_id=None):
        super().__init__()
        self.to, self.subject, self.body, self.reply_to_id = to, subject, body, reply_to_id

    def compose(self) -> ComposeResult:
        with Vertical(id="sheet"):
            yield Input(value=self.to, placeholder="to", id="to")
            yield Input(value=self.subject, placeholder="subject", id="subject")
            yield TextArea(self.body, id="body")
            with Horizontal():
                yield Button("Send", id="send", variant="primary")
                yield Button("Cancel", id="cancel")

    @on(Button.Pressed)
    def clicked(self, event: Button.Pressed):
        if event.button.id == "cancel":
            self.dismiss({})
        else:
            self.dismiss({"to": self.query_one("#to", Input).value,
                          "subject": self.query_one("#subject", Input).value,
                          "body": self.query_one("#body", TextArea).text,
                          "reply_to_id": self.reply_to_id})


class Mail(App):
    CSS = """
    Screen { background: #11151c; color: #c9d3df; }
    #top { height: 1fr; }
    #folders { width: 22; background: #151b23; border-right: solid #262e3a; }
    ListItem { padding: 0 1; background: #151b23; }
    ListItem.--highlight { background: #26303c; color: #5ad1c4; }
    #list-side { width: 1fr; }
    DataTable { height: 1fr; background: #11151c; }
    DataTable > .datatable--header { background: #171d26; color: #71808f; text-style: bold; }
    DataTable > .datatable--cursor { background: #26303c; }
    #actions { height: auto; padding: 0 1; background: #171d26; }
    Button { background: #1d242e; color: #c9d3df; border: none; margin: 0 1 0 0; min-width: 12; }
    Button:hover { background: #26303c; color: #5ad1c4; }
    #reader { height: 18; padding: 1 2; background: #151b23; border-top: solid #262e3a; }
    #subject { text-style: bold; }
    .dim { color: #71808f; }
    #note { height: auto; padding: 0 2; color: #71808f; background: #11151c; }
    #setup { padding: 2 4; }
    """
    BINDINGS = [("q", "quit", "Quit"), ("r", "reload", "Refresh")]

    def __init__(self):
        super().__init__()
        self.cfg = config()
        self.box = None
        self.folder = "INBOX"
        self.rows = []
        self.selected = None
        self.meta = {}

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Horizontal(id="top"):
            yield ListView(*[ListItem(Label(name), id="f-" + str(i))
                             for i, (name, _) in enumerate(FOLDERS)], id="folders")
            with Vertical(id="list-side"):
                with Horizontal(id="actions"):
                    yield Button("Write", id="write", variant="primary")
                    yield Button("Reply", id="reply")
                    yield Button("Archive", id="archive")
                    yield Button("Trash", id="trash")
                    yield Button("Unread", id="unread")
                    yield Button("Refresh", id="reload")
                yield DataTable(cursor_type="row", id="messages")
        with VerticalScroll(id="reader"):
            yield Label("", id="subject")
            yield Label("", id="headers", classes="dim")
            yield Static("", id="body")
        yield Label("", id="note")
        yield Footer()

    def on_mount(self):
        self.title = "Mail"
        self.sub_title = self.cfg["address"]
        self.query_one("#messages", DataTable).add_columns(" ", "from", "subject", "date")
        secret = password()
        if not secret:
            self.note("no app password yet — add one with: "
                      "security add-generic-password -s rex-gmail -a "
                      + self.cfg["address"] + " -w")
            return
        self.box = Mailbox(self.cfg, secret)
        self.load()

    def note(self, text):
        self.query_one("#note", Label).update(text)

    # loading ------------------------------------------------------------

    @work(thread=True, exclusive=True)
    def load(self):
        if not self.box:
            return
        self.call_from_thread(self.note, f"opening {self.folder}…")
        try:
            rows = self.box.headers(self.folder)
        except Exception as exc:
            self.call_from_thread(self.note, f"imap said: {exc}")
            return
        self.call_from_thread(self.paint, rows)

    def paint(self, rows):
        self.rows = rows
        table = self.query_one("#messages", DataTable)
        table.clear()
        for row in rows:
            mark = "●" if row["unread"] else ("★" if row["flagged"] else " ")
            try:
                when = email.utils.parsedate_to_datetime(row["date"]).strftime("%d %b %H:%M")
            except Exception:
                when = ""
            subject = row["subject"]
            if row["unread"]:
                subject = f"[b]{subject}[/b]"
            table.add_row(mark, row["from"][:24], subject[:72], when)
        unread = sum(1 for r in rows if r["unread"])
        self.note(f"{len(rows)} messages, {unread} unread")
        if rows:
            table.move_cursor(row=0)

    @on(ListView.Highlighted, "#folders")
    def folder_changed(self, event: ListView.Highlighted):
        if event.item is None:
            return
        index = int(event.item.id.split("-")[1])
        self.folder = FOLDERS[index][1]
        self.load()

    @on(DataTable.RowHighlighted, "#messages")
    def row_changed(self, event: DataTable.RowHighlighted):
        if 0 <= event.cursor_row < len(self.rows):
            self.selected = self.rows[event.cursor_row]
            self.open_message(self.selected)

    @work(thread=True, exclusive=True)
    def open_message(self, row):
        self.call_from_thread(self.query_one("#subject", Label).update, row["subject"])
        self.call_from_thread(self.query_one("#headers", Label).update, "loading…")
        try:
            text, meta = self.box.body(self.folder, row["uid"])
        except Exception as exc:
            self.call_from_thread(self.query_one("#body", Static).update, f"could not open it: {exc}")
            return
        self.call_from_thread(self.paint_message, row, text, meta)

    def paint_message(self, row, text, meta):
        if not self.selected or self.selected["uid"] != row["uid"]:
            return
        self.meta = meta
        self.query_one("#subject", Label).update(meta.get("subject") or row["subject"])
        self.query_one("#headers", Label).update(
            f"{meta.get('from', '')}  →  {meta.get('to', '')}      {meta.get('date', '')}")
        self.query_one("#body", Static).update(text[:20000] or "(no text part)")
        if row["unread"]:
            row["unread"] = False

    # actions ------------------------------------------------------------

    @on(Button.Pressed)
    def clicked(self, event: Button.Pressed):
        bid = event.button.id or ""
        if bid == "reload":
            self.load()
        elif bid == "write":
            self.write_new()
        elif bid == "reply":
            self.write_reply()
        elif bid == "archive" and self.selected:
            self.move_message("[Gmail]/All Mail", "archived")
        elif bid == "trash" and self.selected:
            self.move_message("[Gmail]/Trash", "moved to trash")
        elif bid == "unread" and self.selected:
            self.mark_unread()

    @work(thread=True)
    def move_message(self, target, note):
        row = self.selected
        try:
            self.box.move(self.folder, row["uid"], target)
        except Exception as exc:
            self.call_from_thread(self.note, f"could not move it: {exc}")
            return
        self.call_from_thread(self.note, f"{note}: {row['subject'][:50]}")
        self.load()

    @work(thread=True)
    def mark_unread(self):
        try:
            self.box.store(self.folder, self.selected["uid"], "\\Seen", plus=False)
        except Exception as exc:
            self.call_from_thread(self.note, f"could not mark it: {exc}")
            return
        self.call_from_thread(self.note, "marked unread")
        self.load()

    @work
    async def write_new(self):
        draft = await self.push_screen_wait(Compose())
        if draft.get("to"):
            self.deliver(draft)

    @work
    async def write_reply(self):
        if not self.selected:
            return
        meta = self.meta
        body = self.query_one("#body", Static).renderable
        quoted = "\n".join("> " + line for line in str(body).splitlines()[:40])
        subject = meta.get("subject", self.selected["subject"])
        if not subject.lower().startswith("re:"):
            subject = "Re: " + subject
        draft = await self.push_screen_wait(Compose(
            to=meta.get("from", ""), subject=subject,
            body="\n\n" + quoted, reply_to_id=meta.get("message_id")))
        if draft.get("to"):
            self.deliver(draft)

    @work(thread=True)
    def deliver(self, draft):
        try:
            self.box.send(draft["to"], draft["subject"], draft["body"], draft.get("reply_to_id"))
        except Exception as exc:
            self.call_from_thread(self.note, f"smtp said: {exc}")
            return
        self.call_from_thread(self.note, f"sent to {draft['to']}")

    def action_reload(self):
        self.load()


if __name__ == "__main__":
    Mail().run()
