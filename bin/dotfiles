#!/bin/sh
# Copy the machine's config into the repo, or back out again.
#
#   dotfiles pull    bring this machine's files into ~/rex/home  (then commit)
#   dotfiles push    write ~/rex/home back onto this machine
#
# These are snapshots, not symlinks, so nothing breaks if the repo is missing.
# Directories are rsynced; --delete only on pull, so a push never removes live files.
set -e
REPO="$HOME/rex/home"
pairs="
zshrc|$HOME/.zshrc
hammerspoon/init.lua|$HOME/.hammerspoon/init.lua
config/rex/init.lua|$HOME/.config/rex/init.lua
config/rex-comms/workspaces.json|$HOME/.config/rex-comms/workspaces.json
config/sketchybar/sketchybarrc|$HOME/.config/sketchybar/sketchybarrc
config/sketchybar/plugins/space.sh|$HOME/.config/sketchybar/plugins/space.sh
config/sketchybar/plugins/front_app.sh|$HOME/.config/sketchybar/plugins/front_app.sh
config/sketchybar/plugins/clock.sh|$HOME/.config/sketchybar/plugins/clock.sh
config/sketchybar/plugins/battery.sh|$HOME/.config/sketchybar/plugins/battery.sh
inkdrop/init.js|$HOME/Library/Application Support/inkdrop/init.js
inkdrop/keymap.json|$HOME/Library/Application Support/inkdrop/keymap.json
inkdrop/styles.css|$HOME/Library/Application Support/inkdrop/styles.css
inkdrop/config.json|$HOME/Library/Application Support/inkdrop/config.json
config/starship.toml|$HOME/.config/starship.toml
gitconfig|$HOME/.gitconfig
"
# Directories, copied whole rather than file by file.
dirs="
config/nvim|$HOME/.config/nvim
"

case "${1:-pull}" in
  pull)
    echo "$dirs" | while IFS='|' read -r rel live; do
      [ -n "$rel" ] || continue
      [ -d "$live" ] || continue
      mkdir -p "$REPO/$rel"
      rsync -a --delete --exclude='.git' "$live/" "$REPO/$rel/" && echo "  pulled   $rel/"
    done
    echo "$pairs" | while IFS='|' read -r rel live; do
      [ -n "$rel" ] || continue
      [ -f "$live" ] || { echo "  missing  $live"; continue; }
      mkdir -p "$REPO/$(dirname "$rel")"
      cp "$live" "$REPO/$rel" && echo "  pulled   $rel"
    done
    ;;
  push)
    echo "$dirs" | while IFS='|' read -r rel live; do
      [ -n "$rel" ] || continue
      [ -d "$REPO/$rel" ] || continue
      mkdir -p "$live"
      rsync -a "$REPO/$rel/" "$live/" && echo "  pushed   $rel/"
    done
    echo "$pairs" | while IFS='|' read -r rel live; do
      [ -n "$rel" ] || continue
      [ -f "$REPO/$rel" ] || continue
      mkdir -p "$(dirname "$live")"
      cp "$REPO/$rel" "$live" && echo "  pushed   $rel"
    done
    ;;
  *) echo "usage: dotfiles [pull|push]"; exit 1 ;;
esac
