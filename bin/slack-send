#!/usr/bin/env python3
"""Post to Slack from the terminal:  slack-send '#channel' 'message'"""
import json, subprocess, sys, urllib.parse, urllib.request

def token():
    out = subprocess.run(["security", "find-generic-password", "-s", "rex-slack", "-w"],
                         capture_output=True, text=True, timeout=10)
    return out.stdout.strip()

def main():
    if len(sys.argv) < 3:
        print("usage: slack-send '#channel|@person' 'message'")
        return 2
    target, text = sys.argv[1], " ".join(sys.argv[2:])
    tok = token()
    if not tok:
        print("no slack token in keychain (service: rex-slack)")
        return 1
    body = urllib.parse.urlencode({"channel": target, "text": text, "as_user": "true"}).encode()
    req = urllib.request.Request("https://slack.com/api/chat.postMessage", data=body,
                                 headers={"Authorization": "Bearer " + tok,
                                          "Content-Type": "application/x-www-form-urlencoded"})
    with urllib.request.urlopen(req, timeout=20) as r:
        res = json.load(r)
    print("sent" if res.get("ok") else "error: " + str(res.get("error")))
    return 0 if res.get("ok") else 1

if __name__ == "__main__":
    sys.exit(main())
