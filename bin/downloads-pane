#!/Users/ivan/rex/venv/bin/python
"""What is downloading, and whether it is still going out through the VPN.

The second half matters more than the first. qBittorrent shares a network
namespace with gluetun, so the question is never "is the VPN container up" but
"is the address the tracker sees still not mine" — which is why both addresses
are on screen at once.
"""
import json
import os
import subprocess
import urllib.error
import urllib.parse
import urllib.request

from textual import on, work
from textual.app import App, ComposeResult
from textual.containers import Horizontal, Vertical
from textual.widgets import Button, DataTable, Footer, Header, Input, Label

QBT = os.environ.get("QBT_URL", "http://127.0.0.1:8080")
PORT_FILE = os.path.expanduser("~/media-stack/gluetun/forwarded_port")
STATES = {
    "stalledDL": "stalled", "stalledUP": "seeding", "downloading": "downloading",
    "uploading": "seeding", "pausedDL": "paused", "pausedUP": "done",
    "stoppedDL": "stopped", "stoppedUP": "done", "queuedDL": "queued",
    "checkingDL": "checking", "checkingUP": "checking", "metaDL": "metadata",
    "error": "error", "missingFiles": "missing files",
}


def api(path, data=None, timeout=10):
    url = f"{QBT}/api/v2/{path}"
    body = urllib.parse.urlencode(data).encode() if data else None
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=body), timeout=timeout) as r:
            text = r.read().decode()
        try:
            return json.loads(text)
        except Exception:
            return text
    except Exception:
        return None


def size(n):
    try:
        n = float(n)
    except Exception:
        return ""
    for unit in ("B", "K", "M", "G", "T"):
        if n < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit in ("B", "K") else f"{n:.1f}{unit}"
        n /= 1024
    return ""


def rate(n):
    return f"{size(n)}/s" if n else ""


def eta(seconds):
    try:
        seconds = int(seconds)
    except Exception:
        return ""
    if seconds >= 8640000 or seconds <= 0:
        return ""
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h {seconds % 3600 // 60}m"
    return f"{seconds // 86400}d"


def host_address():
    try:
        with urllib.request.urlopen("https://ipinfo.io/ip", timeout=8) as r:
            return r.read().decode().strip()
    except Exception:
        return ""


def vpn_health():
    try:
        p = subprocess.run(["docker", "inspect", "--format",
                            "{{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}",
                            "media-vpn"], capture_output=True, text=True, timeout=15)
        return p.stdout.strip()
    except Exception:
        return ""


def forwarded_port():
    try:
        with open(PORT_FILE) as f:
            return f.read().strip()
    except Exception:
        return ""


class Downloads(App):
    CSS = """
    Screen { background: #11151c; color: #c9d3df; }
    #status { height: auto; padding: 1 2; background: #171d26; border-bottom: solid #262e3a; }
    #verdict { text-style: bold; }
    .dim { color: #71808f; }
    .bad { color: #e88b8b; text-style: bold; }
    .good { color: #5ad1c4; text-style: bold; }
    Button { background: #1d242e; color: #c9d3df; border: none; margin: 0 1 1 0; min-width: 12; }
    Button:hover { background: #26303c; color: #5ad1c4; }
    Horizontal { height: auto; }
    Input { background: #1d242e; border: tall #262e3a; color: #c9d3df; width: 36; margin-right: 2; }
    Input:focus { border: tall #5ad1c4; }
    DataTable { height: 1fr; background: #11151c; }
    DataTable > .datatable--header { background: #171d26; color: #71808f; text-style: bold; }
    DataTable > .datatable--cursor { background: #26303c; }
    #detail { height: auto; padding: 0 2; color: #71808f; }
    """
    BINDINGS = [("q", "quit", "Quit"), ("r", "refresh", "Refresh")]

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Vertical(id="status"):
            yield Label("asking qBittorrent…", id="verdict")
            yield Label("", id="tunnel", classes="dim")
        with Horizontal():
            yield Input(placeholder="filter", id="filter")
            yield Button("Start", id="start")
            yield Button("Stop", id="stop")
        yield DataTable(id="torrents", cursor_type="row", zebra_stripes=False)
        yield Label("", id="detail")
        yield Footer()

    def on_mount(self) -> None:
        self.title = "Downloads"
        table = self.query_one("#torrents", DataTable)
        table.add_columns("name", "state", "done", "down", "up", "eta", "size")
        self.rows = {}
        self.all_rows = []
        self.host_ip = ""
        self.look_up_host()
        self.set_interval(10, self.refresh_all)
        self.refresh_all()

    @work(thread=True)
    def look_up_host(self) -> None:
        address = host_address()
        self.call_from_thread(setattr, self, "host_ip", address)

    def action_refresh(self) -> None:
        self.look_up_host()
        self.refresh_all()

    def refresh_all(self) -> None:
        self.load()

    @work(thread=True, exclusive=True)
    def load(self) -> None:
        data = {
            "torrents": api("torrents/info") or [],
            "transfer": api("transfer/info") or {},
            "health": vpn_health(),
            "port": forwarded_port(),
        }
        self.call_from_thread(self.show, data)

    def show(self, data) -> None:
        transfer = data["transfer"]
        exit_ip = transfer.get("last_external_address_v4", "")
        verdict = self.query_one("#verdict", Label)
        if not transfer:
            verdict.update("qBittorrent is not answering")
            verdict.set_classes("bad")
        elif exit_ip and self.host_ip and exit_ip == self.host_ip:
            verdict.update(f"traffic is leaving on your own address  {exit_ip}")
            verdict.set_classes("bad")
        elif exit_ip:
            verdict.update(f"going out through the VPN  {exit_ip}")
            verdict.set_classes("good")
        else:
            verdict.update("no external address reported yet")
            verdict.set_classes("dim")

        bits = []
        if self.host_ip:
            bits.append(f"this house {self.host_ip}")
        bits.append(f"gluetun {data['health'] or '?'}")
        bits.append(f"forwarded port {data['port'] or 'none'}")
        status = transfer.get("connection_status", "")
        if status:
            bits.append(f"connection {status}")
        speeds = f"{rate(transfer.get('dl_info_speed'))} down" if transfer.get("dl_info_speed") else ""
        if speeds:
            bits.append(speeds)
        self.query_one("#tunnel", Label).update("      ".join(bits))

        self.all_rows = sorted(data["torrents"], key=lambda t: t.get("added_on", 0), reverse=True)
        self.fill()

    def fill(self) -> None:
        needle = self.query_one("#filter", Input).value.strip().lower()
        table = self.query_one("#torrents", DataTable)
        table.clear()
        self.rows = {}
        for torrent in self.all_rows:
            name = torrent.get("name", "")
            if needle and needle not in name.lower():
                continue
            key = table.add_row(
                name[:52],
                STATES.get(torrent.get("state", ""), torrent.get("state", "")),
                f"{torrent.get('progress', 0) * 100:.0f}%",
                rate(torrent.get("dlspeed")),
                rate(torrent.get("upspeed")),
                eta(torrent.get("eta")),
                size(torrent.get("size")),
            )
            self.rows[key] = torrent

    @on(Input.Changed, "#filter")
    def filtered(self) -> None:
        self.fill()

    @on(DataTable.RowHighlighted, "#torrents")
    def highlighted(self, event: DataTable.RowHighlighted) -> None:
        torrent = self.rows.get(event.row_key)
        if torrent:
            self.query_one("#detail", Label).update(
                f"{torrent.get('name','')}   {size(torrent.get('downloaded'))} of "
                f"{size(torrent.get('size'))}   {torrent.get('num_seeds',0)} seeds, "
                f"{torrent.get('num_leechs',0)} peers   {torrent.get('save_path','')}")

    def selected_hash(self):
        table = self.query_one("#torrents", DataTable)
        if not self.rows:
            return None
        torrent = self.rows.get(table.coordinate_to_cell_key(table.cursor_coordinate).row_key)
        return torrent.get("hash") if torrent else None

    @on(Button.Pressed, "#start")
    def start(self) -> None:
        digest = self.selected_hash()
        if digest:
            self.command(digest, "start", "resume")

    @on(Button.Pressed, "#stop")
    def stop(self) -> None:
        digest = self.selected_hash()
        if digest:
            self.command(digest, "stop", "pause")

    @work(thread=True)
    def command(self, digest, name, older) -> None:
        # qBittorrent 5 renamed pause and resume to stop and start.
        if api(f"torrents/{name}", {"hashes": digest}) is None:
            api(f"torrents/{older}", {"hashes": digest})
        self.call_from_thread(self.refresh_all)


if __name__ == "__main__":
    Downloads().run()
