#!/Users/ivan/rex/venv/bin/python
"""Put the sessions back after a reboot or a crash.

  boot              recreate the "default" profile
  boot last         recreate the rolling autosave, which is the one to use after a crash
  boot --dry-run    say what it would do
  boot --only www   just that session

Reads ~/.config/rex-comms/profiles/<name>.json, written by `snapshot`.
"""
import json
import os
import subprocess
import sys

HOME = os.path.expanduser("~")
PROFILES = os.path.join(HOME, ".config/rex-comms/profiles")
LEGACY = os.path.join(HOME, ".config/rex-comms/sessions.json")
SHELLS = {"login", "zsh", "bash", "sh", "fish", "nu", ""}
AGENTS = {"claude": "claude --continue", "codex": "codex resume --last"}
B, D, G, Y, R = "\033[1m", "\033[2m", "\033[32m", "\033[33m", "\033[0m"


def rex(*args):
    p = subprocess.run(["rex", *args], capture_output=True, text=True)
    return p.stdout.strip()


def jrex(*args):
    try:
        return json.loads(rex(*args))
    except Exception:
        return {}


def open_sessions():
    try:
        rows = json.loads(rex("ls", "--json")).get("sessions", [])
    except Exception:
        rows = []
    return {row.get("label"): row["session_id"] for row in rows}


def expand(path):
    return os.path.expanduser(path or "~")


def run_args(pane):
    """A pane that was running a ~/rex/bin tool comes back running it, arguments and all.

    --keep-open leaves the pane there as a shell if the tool exits, so quitting the tool
    does not take the pane with it. Older snapshots stored the command as a bare string."""
    command = pane.get("command")
    if not command:
        return []
    if isinstance(command, str):
        command = [command]
    return ["--keep-open", "--", expand(command[0]), *command[1:]]


def resume_agent(session_id, block_id, pane):
    """A pane that had Claude or Codex in it comes back with that work picked up.

    The command is typed into the shell rather than run as the pane's program, so the
    pane is still a shell when you quit the agent, as it was before the reboot."""
    command = AGENTS.get(pane.get("agent", ""))
    if not command or not block_id or pane.get("command"):
        return
    rex("send", "-s", session_id, "-b", block_id, command + "\n")


def make_session(session, dry):
    label = session["label"]
    windows = session.get("windows", [])
    if not windows:
        return
    first_window = windows[0]
    first_pane = first_window["panes"][0]
    if dry:
        print(f"  would create {B}{label}{R} with {len(windows)} tabs")
        return
    created = rex("new", label, "-c", expand(first_pane["cwd"]),
                  "--window", first_window.get("label") or "Shell", "--json",
                  *run_args(first_pane))
    try:
        session_id = json.loads(created)["session_id"]
    except Exception:
        print(f"  {Y}could not create {label}{R}")
        return
    anchor = json.loads(created)["initial_windows"][0]["block_ids"][0]
    resume_agent(session_id, anchor, first_pane)
    add_panes(session_id, anchor, first_window["panes"][1:])
    for window in windows[1:]:
        panes = window["panes"]
        out = rex("window", "new", "-s", session_id, window.get("label") or "Shell",
                  "-c", expand(panes[0]["cwd"]), "--focus=false", "--json",
                  *run_args(panes[0]))
        try:
            block = json.loads(out)["block_ids"][0]
        except Exception:
            continue
        resume_agent(session_id, block, panes[0])
        add_panes(session_id, block, panes[1:])
    print(f"  {G}opened{R} {B}{label}{R}  {D}{len(windows)} tabs{R}")


def add_panes(session_id, anchor, panes):
    for pane in panes:
        out = rex("split", "-s", session_id, "-b", anchor, "--split=right",
                  "-c", expand(pane["cwd"]), "--focus=false", "--json", *run_args(pane))
        try:
            anchor = json.loads(out)["block_ids"][0]
        except Exception:
            return
        resume_agent(session_id, anchor, pane)


def process_tree():
    """parent -> children, and pid -> command name, in one pass."""
    rows = subprocess.run(["/bin/ps", "-axo", "pid,ppid,comm"],
                          capture_output=True, text=True).stdout
    children, names = {}, {}
    for line in rows.splitlines()[1:]:
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            children.setdefault(int(parts[1]), []).append(int(parts[0]))
            names[int(parts[0])] = os.path.basename(parts[2].strip())
    return children, names


def agent_in(session_id, block_id, children, names):
    """The coding agent running under a pane right now, if any."""
    info = jrex("block", "call", "-s", session_id, "-b", block_id, "process")
    pid = (info.get("child") or {}).get("pid")
    if not pid:
        return ""
    seen, frontier = set(), [int(pid)]
    while frontier:
        current = frontier.pop(0)
        for kid in children.get(current, []):
            if kid in seen:
                continue
            seen.add(kid)
            if names.get(kid, "") in AGENTS:
                return names[kid]
            frontier.append(kid)
    return ""


def windows_of(session_id):
    view = jrex("session", "inspect", session_id, "--json")
    found = []
    for window in view.get("windows", []):
        blocks = [b["block_id"] for layer in window.get("layers", [])
                  for b in layer.get("blocks", [])]
        found.append((window.get("label") or "", blocks))
    return found


def reconcile(session_id, session, dry):
    """Bring an already-open session up to what the profile says.

    The Rex server restores its own sessions at login, so by the time this runs the
    session usually exists but with fewer windows and no agents in them: a process does
    not survive a reboot. Skipping it, which is what this used to do, meant a restored
    session never got its agents back. So add the missing windows and resume any agent
    that the profile expected and that is not running."""
    have = {}
    for label, blocks in windows_of(session_id):
        have.setdefault(label, []).append(blocks)
    children, names = process_tree()
    added = resumed = 0

    for window in session.get("windows", []):
        label = window.get("label") or "Shell"
        panes = window.get("panes", [])
        if not panes:
            continue
        slots = have.get(label)
        if slots:
            blocks = slots.pop(0)
            if not slots:
                have.pop(label, None)
            for pane, block in zip(panes, blocks):
                if not pane.get("agent"):
                    continue
                if agent_in(session_id, block, children, names):
                    continue
                if not dry:
                    resume_agent(session_id, block, pane)
                resumed += 1
            continue
        added += 1
        if dry:
            continue
        out = rex("window", "new", "-s", session_id, label,
                  "-c", expand(panes[0]["cwd"]), "--focus=false", "--json",
                  *run_args(panes[0]))
        try:
            block = json.loads(out)["block_ids"][0]
        except Exception:
            continue
        resume_agent(session_id, block, panes[0])
        add_panes(session_id, block, panes[1:])
    return added, resumed


def tailnet():
    """Re-serve the API over the tailnet. `tailscale on` is runtime-only, so a
    restarted server comes back with it off. The enrolled identity is kept, so
    this needs no sign-in."""
    status = rex("server", "status")
    if "tailscale: disabled" not in status:
        return
    rex("server", "tailscale", "on")
    print(f"  {G}tailnet{R} on")


def main():
    dry = "--dry-run" in sys.argv
    only = None
    if "--only" in sys.argv:
        index = sys.argv.index("--only")
        only = sys.argv[index + 1] if index + 1 < len(sys.argv) else None
    positional = [a for a in sys.argv[1:] if not a.startswith("-")]
    if only in positional:
        positional.remove(only)
    name = positional[0] if positional else "default"

    snap = os.path.join(PROFILES, f"{name}.json")
    if not os.path.exists(snap) and name == "default" and os.path.exists(LEGACY):
        snap = LEGACY
    if not os.path.exists(snap):
        print(f"nothing saved as {B}{name}{R} — run {B}snapshot {name}{R} "
              f"while your sessions are open")
        print(f"{D}saved profiles:{R}")
        subprocess.run([os.path.join(HOME, "rex/bin/snapshot"), "--list"])
        return 1
    with open(snap) as f:
        saved = json.load(f)

    running = open_sessions()
    print(f"{B}Restoring Rex{R}  {D}{name}{R}\n")
    if not dry:
        tailnet()
        subprocess.run([os.path.expanduser("~/rex/bin/mini-link")],
                       capture_output=True)
    for session in saved.get("sessions", []):
        label = session["label"]
        if only and label != only:
            continue
        if label in running:
            added, resumed = reconcile(running[label], session, dry)
            if added or resumed:
                bits = []
                if added:
                    bits.append(f"{added} windows")
                if resumed:
                    bits.append(f"{resumed} agents")
                verb = "would restore" if dry else "restored"
                print(f"  {G}{verb}{R} {B}{label}{R}  {D}{' and '.join(bits)}{R}")
            else:
                print(f"  {D}already complete{R}  {label}")
            continue
        if session.get("builder"):
            builder = expand(session["builder"])
            if dry:
                print(f"  would run {builder}")
                continue
            subprocess.run([builder], capture_output=True)
            print(f"  {G}built{R} {B}{label}{R}  {D}{session['builder']}{R}")
        else:
            make_session(session, dry)
    print(f"\n{D}profile: {snap.replace(HOME, '~', 1)}{R}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
