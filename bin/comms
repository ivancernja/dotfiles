#!/usr/bin/env bash
# Build the Home session, or focus it if it is already running.
set -e
BIN="$HOME/rex/bin"

sid=$(rex ls --json | jq -r '.sessions[]? | select(.label=="Home") | .session_id' | head -1)
if [ -n "$sid" ]; then
  rex do session.select session_id="$sid" 2>/dev/null || true
  echo "$sid"
  exit 0
fi

created=$(rex new Home --window "󰃭  Calendar" --json -- "$BIN/agenda-pane")
sid=$(printf '%s' "$created" | jq -er '.session_id')

tab() { rex window new -s "$sid" "$1" --focus=false --keep-open -- "$2" >/dev/null; }

tab "󰠹  TV" "$BIN/tv-pane"

# The rest only belong on the machine that actually runs these things, which is
# the mini. On a laptop they would be four tabs of nothing.
if command -v docker >/dev/null 2>&1; then tab "󰋜  House" "$BIN/house-pane"; fi
if curl -fsS -m 2 -o /dev/null http://127.0.0.1:8080/api/v2/app/version 2>/dev/null; then
  tab "󰇚  Downloads" "$BIN/downloads-pane"
fi
if curl -fsS -m 2 -o /dev/null http://127.0.0.1:8777/admin/status 2>/dev/null; then
  tab "󰗚  Reading" "$BIN/reading-pane"
fi

rex do session.select session_id="$sid" 2>/dev/null || true
echo "$sid"
